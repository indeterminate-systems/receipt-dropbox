// Receipt Dropbox interfaces. Host capabilities mirror the traits in the `rdx-host` crate, and
// `cargo xtask check-wit` keeps the two in step (ADR-0001): change both together.
//
// Host capabilities are imported by the core; extension interfaces are exported by extensions.
// Values that cross the boundary as structured data use JSON text, matching plan arguments, until
// the domain model (piece 3) settles.
package rdx:core@0.1.0;

interface types {
    /// `sha256:<hex>`
    type digest = string;
    /// JSON text.
    type json = string;

    record capability-error {
        message: string,
    }
}

// ---- Host capabilities ----

interface blob-store {
    use types.{digest, capability-error};
    /// Stores ciphertext; returns its digest, which is also its address.
    put: func(bytes: list<u8>) -> result<digest, capability-error>;
    get: func(id: digest) -> result<option<list<u8>>, capability-error>;
    delete: func(id: digest) -> result<_, capability-error>;
}

interface kv {
    use types.{capability-error};
    get: func(key: string) -> result<option<list<u8>>, capability-error>;
    put: func(key: string, value: list<u8>) -> result<_, capability-error>;
    delete: func(key: string) -> result<_, capability-error>;
}

interface mail-out {
    use types.{capability-error};
    record message {
        to: string,
        subject: string,
        text: string,
    }
    send: func(msg: message) -> result<_, capability-error>;
}

interface audit-log {
    use types.{capability-error};
    /// Appends one line (a run's audit entry, canonical JSON).
    append: func(line: string) -> result<_, capability-error>;
    /// The most recent line, which the next entry chains to.
    last: func() -> result<option<string>, capability-error>;
}

interface secrets {
    use types.{capability-error};
    /// The passkey's PRF output for `salt` (WebAuthn `prf`, `eval.first`); may prompt the person.
    prf: func(salt: list<u8>) -> result<list<u8>, capability-error>;
    /// Shows a secret to the person (a recovery share to hand out), never to the run.
    show: func(label: string, secret: string) -> result<_, capability-error>;
    /// Asks the person for a secret they hold; `none` when they have no more.
    ask: func(label: string) -> result<option<string>, capability-error>;
}

// Clock and randomness come from WASI (wasi:clocks, wasi:random) on component hosts and from the
// host runtime on statically linked builds.

// ---- Extension interfaces ----

// A statement parser sees the document as JSON: `{ "text": "…" }` for CSV and OFX, or
// `{ "pages": [...] }` with the lines and spans of a PDF's text layer (`rdx_pdf::Text`).
interface statement-parser {
    use types.{json, capability-error};
    /// Whether this parser recognises the document.
    detect: func(document: json) -> bool;
    /// What the document states, as JSON (`rdx_statement::Parsed`): account, currency, period,
    /// balances and totals where printed, and lines with decimal-text amounts. `hints` carries
    /// what the caller knows (currency, CSV options). The core checks and numbers the result.
    parse: func(document: json, hints: json) -> result<json, capability-error>;
}

interface receipt-extractor {
    use types.{json, capability-error};
    /// Whether this extractor reads the text (an email body, HTML, a PDF's text layer, XML).
    detect: func(text: string, media-type: string) -> bool;
    /// Hints (currency, date order, merchant) and the result as JSON: the `Found` fields of
    /// `rdx-receipt` (merchant, date, total, reference, kind, fiscal, warnings).
    extract: func(text: string, media-type: string, hints: json) -> result<json, capability-error>;
}

interface match-strategy {
    use types.{json, capability-error};
    /// Proposed matches for statement lines and receipts under a policy, all as JSON.
    propose: func(lines: json, receipts: json, policy: json) -> result<json, capability-error>;
}

interface ledger-writer {
    use types.{json, capability-error};
    /// Ledger text for matched transactions, with audit metadata.
    write: func(matches: json) -> result<string, capability-error>;
}

world statement-parser-ext {
    export statement-parser;
}

world receipt-extractor-ext {
    export receipt-extractor;
}

world match-strategy-ext {
    export match-strategy;
}

world ledger-writer-ext {
    export ledger-writer;
}

/// The core as a component: imports host capabilities.
world core {
    import blob-store;
    import kv;
    import mail-out;
    import audit-log;
    // Only hosts where the person is present (the PWA, the local host) supply it.
    import secrets;
}
